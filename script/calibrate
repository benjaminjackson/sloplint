#!/usr/bin/env ruby
# frozen_string_literal: true

# Calibrate a judge backend against real prose. See docs/JUDGE.md "Calibration corpus" and "Adding a backend".
#
#   script/calibrate run [--rules IDS] [--register R,R] [--sample N] [--generated MODEL]
#       Per rule, register and model side: the probability that a model unit scores higher than a human one
#       (AUC), the `check` agreement rate between two runs at each confidence band, and the `compare` flip
#       rate under passage-order swap at each band. Ends with the pass/fail lines from docs/JUDGE.md.
#   script/calibrate generate MODEL [--register R,R] [--sample N]
#       Write a current-model side into .corpus/*/generated/MODEL/ from RAID's own prompts (news, abstracts)
#       and from engineering prompts (rfc). Needs ANTHROPIC_API_KEY. Nothing generated is committed.
#   script/calibrate fetch rfc|hn
#       Human side for the engineering register (IETF RFCs) and forum comments (Hacker News, caveat only).
#
# Registers: news and abstracts come from RAID (script/probe-raid fetch first); rfc is the engineering
# register; hn is reported and never gated on. Everything lives under the ignored .corpus/ directory.
require "optparse"
require "csv"
require "json"
require "net/http"
require "fileutils"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "sloplint/judge"

CORPUS = File.expand_path("../.corpus", __dir__)
RAID = File.join(CORPUS, "raid")
REGISTERS = { "news" => "raid", "abstracts" => "raid", "rfc" => "rfc", "hn" => "hn" }.freeze
GATED = %w[news abstracts rfc].freeze
# The reader each register's questions are asked for, and the venue compare names.
READER = { "news" => "a reader of a news article", "abstracts" => "a researcher reading the abstract of a paper",
           "rfc" => "an engineer reading a standards document", "hn" => "a reader of a forum thread" }.freeze
PLACE = { "news" => "as a paragraph of a news article", "abstracts" => "in the abstract of a paper",
          "rfc" => "in an engineering standards document", "hn" => "as a forum comment" }.freeze
# RAID rows pair by title; the rfc and hn sides are generated from their own prompts and pair by position.
PAIRED = %w[news abstracts].freeze
BANDS = { "high" => 0.7, "medium" => 0.5, "low" => 0.0 }.freeze
PARAS_PER_TEXT = 2

opts = { sample: 30, registers: REGISTERS.keys, rules: Sloplint::Judge::RULES.map(&:id), backend: nil }
OptionParser.new do |o|
  o.on("--rules IDS") { |v| opts[:rules] = v.split(",") }
  o.on("--register LIST") { |v| opts[:registers] = v.split(",") }
  o.on("--sample N", Integer) { |n| opts[:sample] = n }
  o.on("--generated MODEL") { |v| opts[:generated] = v }
  o.on("--backend NAME") { |v| opts[:backend] = v }
end.parse!

def rows(path) = File.exist?(path) ? File.foreach(path).map { |l| JSON.parse(l) } : []

# Human rows for a register, and the model rows keyed by side name ("gpt4", "claude-sonnet-5", ...).
def load_register(reg, sample, generated)
  dir = File.join(CORPUS, REGISTERS.fetch(reg))
  base = reg == "news" || reg == "abstracts" ? rows(File.join(dir, "#{reg}.jsonl")) : rows(File.join(dir, "human.jsonl"))
  abort "no corpus for #{reg}; see the usage comment at the top of script/calibrate" if base.empty?
  human = base.select { |r| r["model"] == "human" }.first(sample)
  keys = human.map { |r| r["source_id"] || r["id"] }
  sides = base.reject { |r| r["model"] == "human" }.group_by { |r| r["model"] }
  if generated
    gen = rows(File.join(dir, "generated", generated, "#{reg}.jsonl"))
    sides[generated] = gen unless gen.empty?
  end
  sides = sides.transform_values { |rs| PAIRED.include?(reg) ? rs.select { |r| keys.include?(r["source_id"]) } : rs.first(sample) }
  [human, sides.reject { |_, v| v.empty? }]
end

# Units of one text: the first PARAS_PER_TEXT paragraphs of three or more sentences, and their sentences.
def units(text)
  paras = Sloplint::Split.paragraphs(text).select { |p| p.sentences.size >= 3 }.first(PARAS_PER_TEXT)
  [paras, paras.flat_map { |p| p.sentences.each_index.map { |i| [p, i] } }]
end

# P(a pos value exceeds a neg value), ties at half. Equal to the Mann-Whitney AUC.
# ponytail: O(n*m) over a few thousand units; rank it if the samples grow.
def auc(pos, neg)
  return nil if pos.empty? || neg.empty?

  pos.sum { |p| neg.count { |n| p > n } + 0.5 * neg.count { |n| p == n } } / (pos.size * neg.size).to_f
end

# Score every unit of every text with every rule, twice for the agreement rate. The score is the
# expected level, so higher is better prose and level 0 (the flagged level) is the bottom. Returns
# [{rule:, side:, score:, flagged:, confidence:, flagged_again:}].
def score(texts, side, rules, backend, reg)
  eng = Sloplint::Judge::Engine
  register = READER.fetch(reg)
  para_rules, sent_rules = rules.partition { |r| r.unit == :paragraph }
  pq = eng.questions_for(para_rules, register)
  sq = eng.questions_for(sent_rules, register)
  jobs = texts.flat_map do |t|
    paras, sents = units(t["text"])
    paras.map { |p| [pq, { "register" => register, "paragraph" => p.text, "sentence_count" => p.sentences.size }] } +
      sents.map { |(p, i)| [sq, { "register" => register, "paragraph" => { "sentences" => p.sentences.map(&:text) }, "target_index" => i, "target" => p.sentences[i].text }] }
  end.reject { |q, _| q.empty? }
  twice = eng.in_parallel(jobs, 8) { |(q, state)| [backend.ask(state, q), backend.ask(state, q)] }
  jobs.zip(twice).flat_map do |(q, _), (a, b)|
    q.keys.map do |id|
      rule = rules.find { |r| r.id == id }
      { rule: id, side: side, score: a[id].probabilities.each_with_index.sum { |p, i| p * i }, flagged: eng.flagged?(rule, a[id]),
        confidence: a[id].confidence, flagged_again: eng.flagged?(rule, b[id]) }
    end
  end
end

def run(opts)
  backend = Sloplint::Judge::Backend.load(*[opts[:backend]].compact)
  rules = Sloplint::Judge::RULES.select { |r| opts[:rules].include?(r.id) }
  scored = []
  flips = []
  opts[:registers].each do |reg|
    human, sides = load_register(reg, opts[:sample], opts[:generated])
    warn "#{reg}: #{human.size} human texts; model sides: #{sides.map { |k, v| "#{k} (#{v.size})" }.join(", ")}"
    scored.concat(score(human, "human", rules, backend, reg).map { |h| h.merge(register: reg) })
    sides.each do |side, texts|
      scored.concat(score(texts, side, rules, backend, reg).map { |h| h.merge(register: reg) })
      # compare: a human paragraph against a model paragraph (same title where RAID pairs them,
      # same position otherwise), in both orders.
      pairs = texts.each_with_index.filter_map do |m, i|
        h = PAIRED.include?(reg) ? human.find { |x| (x["source_id"] || x["id"]) == m["source_id"] } : human[i]
        hp, = units(h["text"]) if h
        mp, = units(m["text"])
        [hp.first.text, mp.first.text] if hp&.first && mp.first
      end
      Sloplint::Judge::Engine.in_parallel(pairs, 8) do |(a, b)|
        one = Sloplint::Judge::Compare.run(a, b, place: PLACE.fetch(reg), backend: backend, swap: false)
        two = Sloplint::Judge::Compare.run(a, b, place: PLACE.fetch(reg), backend: backend, swap: true)
        [one, two]
      end.each { |one, two| flips << { register: reg, side: side, flip: one.keep != two.keep, confidence: [one.keep_confidence, two.keep_confidence].min } }
    end
  end

  puts "\nP(model unit scores higher than human unit)   (score = expected level, higher is better prose; <0.5 = the rule ranks model prose below human)"
  sides = scored.map { |s| s[:side] }.uniq - ["human"]
  opts[:registers].each do |reg|
    puts "\n#{reg}#{GATED.include?(reg) ? "" : "  (reported, not gated)"}"
    puts format("  %-16s %s", "rule", sides.map { |s| format("%18s", s) }.join)
    rules.each do |r|
      cells = sides.map do |s|
        pos = scored.select { |x| x[:register] == reg && x[:side] == s && x[:rule] == r.id }.map { |x| x[:score] }
        neg = scored.select { |x| x[:register] == reg && x[:side] == "human" && x[:rule] == r.id }.map { |x| x[:score] }
        v = auc(pos, neg)
        format("%18s", v ? format("%.2f", v) : "-")
      end
      puts format("  %-16s %s", r.id, cells.join)
    end
  end

  puts "\ncheck agreement between two runs, by confidence band"
  BANDS.each do |band, floor|
    rows = scored.select { |x| x[:confidence] >= floor }
    agree = rows.count { |x| x[:flagged] == x[:flagged_again] }
    puts format("  >= %-7s %5d units  %5.1f%% agree", band, rows.size, rows.empty? ? 0 : 100.0 * agree / rows.size)
  end

  puts "\ncompare flip rate under order swap, by confidence band"
  BANDS.each do |band, floor|
    rows = flips.select { |x| x[:confidence] >= floor }
    puts format("  >= %-7s %5d pairs  %5.1f%% flip", band, rows.size, rows.empty? ? 0 : 100.0 * rows.count { |x| x[:flip] } / rows.size)
  end

  puts "\ngate (docs/JUDGE.md \"Adding a backend\")"
  current = opts[:generated]
  if current && sides.include?(current)
    %w[no-news names-nothing].each do |id|
      next unless rules.any? { |r| r.id == id }

      (opts[:registers] & GATED).each do |reg|
        pos = scored.select { |x| x[:register] == reg && x[:side] == current && x[:rule] == id }.map { |x| x[:score] }
        neg = scored.select { |x| x[:register] == reg && x[:side] == "human" && x[:rule] == id }.map { |x| x[:score] }
        v = auc(pos, neg)
        puts format("  %-4s %-14s %-9s %s", v && v < 0.5 ? "ok" : "FAIL", id, reg, v ? format("%.2f", v) : "no data")
      end
    end
  else
    puts "  skipped: no current-model side (pass --generated MODEL after `script/calibrate generate MODEL`)"
  end
  hi = flips.select { |x| x[:confidence] >= 0.7 }
  if hi.empty?
    puts "  n/a  compare flip at >= 0.7: no pairs at that confidence"
  else
    puts format("  %-4s compare flip at >= 0.7: %.1f%% of %d", hi.count { |x| x[:flip] } < hi.size / 100.0 ? "ok" : "FAIL", 100.0 * hi.count { |x| x[:flip] } / hi.size, hi.size)
  end
  hc = scored.select { |x| x[:confidence] >= 0.7 }
  ag = hc.empty? ? 0 : 100.0 * hc.count { |x| x[:flagged] == x[:flagged_again] } / hc.size
  puts format("  %-4s check agreement at >= 0.7: %.1f%% of %d", ag >= 90 ? "ok" : "FAIL", ag, hc.size)
end

# ── generate ──────────────────────────────────────────────────────────────────
ENGINEERING_PROMPTS = [
  "Write the design document for moving the billing service's invoice generation from a nightly cron job to a queue-driven worker. Name the queue, the failure that made the change necessary, and the rollout steps.",
  "Write the postmortem for an outage in which the session store's primary node ran out of disk at 03:10 and logins failed for forty minutes. Include the timeline, the root cause and the follow-up actions.",
  "Write the README for a command-line tool that rotates the TLS certificates on a fleet of edge proxies. Cover installation, the one config file, and what happens when a rotation fails halfway.",
  "Write the design document for adding a rate limit to the public search API after a single client sent 40,000 requests a minute. Say where the limit lives, what it returns, and how it is tuned.",
  "Write the postmortem for a deploy that shipped a migration which locked the orders table for eleven minutes during checkout. Include the timeline, the root cause and the follow-up actions.",
  "Write the README for a library that parses the vendor's flat-file export of shipment records into structured rows. Cover the record types, the two known encoding problems, and how errors are reported."
].freeze

def anthropic(model, prompt)
  key = ENV["ANTHROPIC_API_KEY"].to_s
  abort "generate needs ANTHROPIC_API_KEY" if key.empty?
  uri = URI("https://api.anthropic.com/v1/messages")
  req = Net::HTTP::Post.new(uri, "content-type" => "application/json", "x-api-key" => key, "anthropic-version" => "2023-06-01")
  req.body = JSON.generate(model: model, max_tokens: 1500, messages: [{ role: "user", content: prompt }])
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true, read_timeout: 120) { |h| h.request(req) }
  abort "generate: #{res.code} #{res.body[0, 300]}" unless res.code == "200"
  JSON.parse(res.body).fetch("content").map { |c| c["text"] }.join
end

# RAID's fetch keeps the generation and not the prompt, so the prompts for the sampled titles are
# read back out of the CSV. One pass over the file, filtered to the ids wanted.
def raid_prompts(ids)
  csv = File.join(RAID, "train_none.csv")
  abort "no #{csv}; run script/probe-raid fetch" unless File.exist?(csv)
  found = {}
  CSV.foreach(csv, headers: true) do |r|
    next if r["model"] == "human" || found.key?(r["source_id"]) || !ids.include?(r["source_id"])

    found[r["source_id"]] = r["prompt"]
    break if found.size == ids.size
  end
  found
end

def generate(model, opts)
  opts[:registers].each do |reg|
    dir = File.join(CORPUS, REGISTERS.fetch(reg), "generated", model)
    FileUtils.mkdir_p(dir)
    out = File.join(dir, "#{reg}.jsonl")
    done = rows(out).to_h { |r| [r["source_id"], true] }
    jobs =
      if reg == "rfc"
        ENGINEERING_PROMPTS.each_with_index.map { |p, i| ["eng-#{i}", "engineering prompt #{i}", p] }
      elsif reg == "hn"
        human, = load_register(reg, opts[:sample], nil)
        human.map { |r| [r["source_id"], r["title"], "Write a Hacker News comment, two or three paragraphs, on a story titled \"#{r["title"]}\"."] }
      else
        human, = load_register(reg, opts[:sample], nil)
        prompts = raid_prompts(human.map { |r| r["source_id"] })
        human.filter_map { |r| (p = prompts[r["source_id"]]) && [r["source_id"], r["title"], p] }
      end
    jobs.reject! { |id, _, _| done[id] }
    warn "#{reg}: generating #{jobs.size} texts with #{model}"
    File.open(out, "a") do |f|
      Sloplint::Judge::Engine.in_parallel(jobs, 4) { |(id, title, prompt)| [id, title, anthropic(model, prompt)] }
                            .each { |id, title, text| f.puts JSON.generate(model: model, source_id: id, title: title, text: text) }
    end
  end
end

# ── fetch ─────────────────────────────────────────────────────────────────────
def fetch(what)
  dir = File.join(CORPUS, what)
  FileUtils.mkdir_p(dir)
  out = File.join(dir, "human.jsonl")
  case what
  when "rfc"
    # Forty RFCs from the 8000s and 9000s: current-era standards prose, plain text, public.
    numbers = (8000..9999).step(50).first(40)
    File.open(out, "w") do |f|
      numbers.each do |n|
        body = Net::HTTP.get(URI("https://www.rfc-editor.org/rfc/rfc#{n}.txt"))
        next if body.nil? || body.size < 5000

        # Drop the page headers and footers that RFC text carries every 58 lines.
        text = body.gsub(/^RFC \d+.*$\n|^\S.*\[Page \d+\]$\n|\f/, "")
        f.puts JSON.generate(model: "human", id: "rfc#{n}", source_id: "rfc#{n}", title: body.lines.find { |l| l.strip.size > 20 }.to_s.strip, text: text)
        warn "rfc#{n}"
      end
    end
  when "hn"
    res = Net::HTTP.get(URI("https://hn.algolia.com/api/v1/search_by_date?tags=comment&hitsPerPage=200"))
    File.open(out, "w") do |f|
      JSON.parse(res).fetch("hits").each do |h|
        text = h["comment_text"].to_s.gsub(%r{<p>}, "\n\n").gsub(/<[^>]+>/, "").strip
        next if text.size < 400

        f.puts JSON.generate(model: "human", id: h["objectID"], source_id: h["objectID"], title: h["story_title"], text: text)
      end
    end
  else
    abort "fetch rfc|hn"
  end
  puts "wrote #{out}"
end

case ARGV.shift
when "run" then run(opts)
when "generate" then generate(ARGV.shift || abort("generate MODEL"), opts)
when "fetch" then fetch(ARGV.shift)
else abort File.read(__FILE__).lines.grep(/^#   /).join
end
